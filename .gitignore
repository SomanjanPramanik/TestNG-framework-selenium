# JMeter generated results (regenerated per run, no need to version)
src/test/resources/apache-jmeter-5.6.3/JMeter reports/Summary reports/*.csv
src/test/resources/apache-jmeter-5.6.3/JMeter reports/JMeter html reports/*

# Apache JMeter installation itself (bundled binaries/libs, not your code —
# this is what caused the 72MB push; anyone running the framework needs
# JMeter's jars pulled via Maven deps or a local install, not a committed copy)
